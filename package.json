{
  "name": "fincalc-hub",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro check",
    "sources:check": "node scripts/check-sources.mjs",
    "sources:accept": "node scripts/check-sources.mjs --accept --write-status",
    "check:built": "node scripts/check-built.mjs",
    "verify": "vitest run && astro build && node scripts/check-built.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0"
  }
}
