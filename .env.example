# Copy to .env (local) or set in Cloudflare Pages > Settings > Environment variables.
PUBLIC_SITE_URL=https://yourdomain.com
# Leave empty to keep ads completely disabled.
PUBLIC_ADSENSE_CLIENT=
# Optional ad unit IDs (one per placement). If empty the slot uses responsive auto format.
PUBLIC_ADSENSE_SLOT_HEADER=
PUBLIC_ADSENSE_SLOT_RESULT=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Optional Google Analytics 4 measurement ID (loaded only after consent).
PUBLIC_GA_ID=
