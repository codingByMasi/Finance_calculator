---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { guides, type Guide } from '../../config/guides';
import { toolBySlug, toolIcons } from '../../config/tools';
import { editorial, personJsonLd, organizationJsonLd } from '../../config/editorial';
import { SITE_NAME, SITE_URL } from '../../config/site';
import { fmtDate } from '../../lib/data-status';

export const getStaticPaths = (() => guides.map((g) => ({ params: { slug: g.slug }, props: { guide: g } }))) satisfies GetStaticPaths;
const { guide } = Astro.props as { guide: Guide };
const url = `${SITE_URL}/guides/${guide.slug}/`;
const related = guide.tools.map(toolBySlug).filter((t) => !!t);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: guide.title, description: guide.description, url, mainEntityOfPage: url, datePublished: guide.published, dateModified: guide.updated, publisher: { '@id': `${SITE_URL}/#organization` }, ...(editorial.author ? { author: personJsonLd(editorial.author) } : {}), ...(guide.references.length ? { citation: guide.references.map((r) => r.url) } : {}) },
  organizationJsonLd(),
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE_URL}/guides/` },
    { '@type': 'ListItem', position: 3, name: guide.title, item: url }] },
];
---
<BaseLayout title={guide.title} description={guide.description} path={`/guides/${guide.slug}/`} ogType="article" jsonLd={jsonLd}>
  <div class="calculator-heading"><Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }, { name: guide.title }]} /></div>
  <article class="static-article">
    <h1>{guide.title}</h1>
    <p class="lead">{guide.intro}</p>
    <p class="static-meta">Published {fmtDate(guide.published)} · Updated {fmtDate(guide.updated)}</p>
    <div class="article-rule"></div>
    <div class="prose-page">
      <p class="advice-note"><strong>General information only.</strong> This guide is not financial, tax or legal advice and does not recommend any product or course of action. Figures are examples or are taken from the sources listed below; see the <a href="/disclaimer/">disclaimer</a>.</p>
      {guide.sections.map((s) => (<><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>))}
      <h2>Related calculators</h2>
      <ul class="guide-tools">
        {related.map((t) => <li><a href={`/${t!.slug}/`}><Icon name={toolIcons[t!.slug] ?? 'calc'} size={16} /> {t!.shortTitle}</a></li>)}
      </ul>
      {guide.references.length > 0 && (<><h2>References</h2><ul>{guide.references.map((r) => <li><a href={r.url} rel="noopener">{r.label}</a></li>)}</ul></>)}
      <p>Found a mistake? See the <a href="/corrections/">corrections policy</a> or <a href="/contact/">contact {SITE_NAME}</a>.</p>
    </div>
  </article>
</BaseLayout>
