---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { guides } from '../../config/guides';
import { SITE_NAME, SITE_URL } from '../../config/site';
import { fmtDate } from '../../lib/data-status';
---
<BaseLayout
  title="Guides"
  description={`Plain-language explainers from ${SITE_NAME} on EMIs, savings products, income tax regimes, 401(k) limits and refinancing. General information, not advice.`}
  path="/guides/"
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE_URL}/guides/` }] }]}
>
  <div class="calculator-heading"><Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides' }]} /></div>
  <div class="page-intro"><h1>Guides</h1><p>Short explainers on how the calculations work. They describe the rules and the arithmetic. They are general information, not financial, tax or legal advice.</p></div>
  <div class="tools-grid">
    {guides.map((g) => (
      <a class="tool-card" href={`/guides/${g.slug}/`}>
        <span><strong>{g.title}</strong><small>{g.description}</small><small>Updated {fmtDate(g.updated)}</small></span>
      </a>
    ))}
  </div>
</BaseLayout>
