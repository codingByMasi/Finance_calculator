---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolCard from '../components/ToolCard.astro';
import { CATEGORIES, SITE_URL } from '../config/site';
import { tools, toolsByCategory } from '../config/tools';

export const getStaticPaths = (() => [
  ...tools.map((tool) => ({ params: { slug: tool.slug }, props: { kind: 'tool' as const, tool } })),
  ...CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { kind: 'category' as const, category: c } })),
]) satisfies GetStaticPaths;

const props = Astro.props as any;
const category = props.kind === 'category' ? props.category : null;
const list = category ? toolsByCategory(category.slug) : [];
---
{props.kind === 'tool' ? (
  <CalculatorLayout tool={props.tool} />
) : (
  <BaseLayout
    title={category.title}
    description={category.description}
    path={`/${category.slug}/`}
    jsonLd={[{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
      { '@type': 'ListItem', position: 2, name: category.title, item: `${SITE_URL}/${category.slug}/` }] }]}
  >
    <div class="calculator-heading"><Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: category.title }]} /></div>
    <div class="page-intro"><h1>{category.title}</h1><p>{category.description}</p></div>
    <div class="tools-grid">
      {list.map((t) => <ToolCard tool={t} />)}
    </div>
    <p class="all-links">Browse by country: <a href="/in/">India</a> · <a href="/us/">United States</a></p>
  </BaseLayout>
)}
