---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CalculatorTool from '../components/CalculatorTool.astro';
import AdSlot from '../components/AdSlot.astro';
import Icon from '../components/Icon.astro';
import SourcesBlock from '../components/SourcesBlock.astro';
import { editorial, personJsonLd, organizationJsonLd } from '../config/editorial';
import { toolReferences } from '../config/references';
import { SITE_NAME, SITE_URL, CATEGORIES } from '../config/site';
import { dataForTool, sourcesLastChecked, fmtDate } from '../lib/data-status';
import { toolBySlug, toolIcons, type Tool } from '../config/tools';
import { getToolDef } from '../lib/tools';
import { defaults } from '../lib/tools/types';
import { taxIndia } from '../config/tax-india';
import { taxUS } from '../config/tax-us';
import { gstIndia } from '../config/gst-india';

interface Props { tool: Tool }
const { tool } = Astro.props;
const cat = CATEGORIES.find((c) => c.slug === tool.category)!;
const path = `/${tool.slug}/`;
const url = SITE_URL + path;
const def = getToolDef(tool.slug);
const example = def.compute(defaults(def.fields));
const related = tool.related.map(toolBySlug).filter((t): t is Tool => !!t);

// Where this tool's rates come from (for the Assumptions box)
const dep = dataForTool(tool.slug);
const meta =
  tool.slug === 'income-tax-calculator-india' ? { sources: taxIndia.sourceUrls, note: taxIndia.verificationNote }
  : tool.slug === 'paycheck-calculator' ? { sources: taxUS.sourceUrls, note: taxUS.verificationNote }
  : tool.slug === 'gst-calculator' ? { sources: gstIndia.sourceUrls, note: gstIndia.verificationNote }
  : { sources: [] as string[], note: '' };
const data = { updated: dep.updated, label: dep.label, ...meta };

const crumbs = [{ name: 'Home', href: '/' }, { name: cat.title, href: `/${cat.slug}/` }, { name: tool.shortTitle }];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: tool.title, url, description: tool.description, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@id': `${SITE_URL}/#organization` }, dateModified: data.updated, ...(editorial.author ? { author: personJsonLd(editorial.author) } : {}), ...(editorial.reviewer ? { reviewedBy: personJsonLd(editorial.reviewer) } : {}) },
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${url}#webpage`, url, name: tool.title, dateModified: data.updated, isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL + '/' }, publisher: { '@id': `${SITE_URL}/#organization` }, ...(editorial.author ? { author: personJsonLd(editorial.author) } : {}), ...(editorial.reviewer ? { reviewedBy: personJsonLd(editorial.reviewer) } : {}), ...(toolReferences(tool.slug).length ? { citation: toolReferences(tool.slug).map((r) => r.url) } : {}) },
  organizationJsonLd(),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: tool.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, ...(c.href ? { item: SITE_URL + c.href } : { item: url }) })) },
];
---
<BaseLayout title={tool.title} description={tool.description} path={path} country={tool.country} jsonLd={jsonLd}>
  <div class="shell-inner">
    <div class="calculator-heading">
      <Breadcrumbs items={crumbs} />
      <div class="title-with-badge">
        <div>
          <h1>{tool.title}</h1>
          <p>{tool.description}</p>
        </div>
        <span class="updated-badge">Data updated {fmtDate(data.updated)}</span>
      </div>
    </div>

    <CalculatorTool slug={tool.slug} />

    <div class:list={['lower-content']}>
      <article class="article">
        <h2 id="how-h">How it works</h2>
        {tool.about.map((p) => <p>{p}</p>)}
        <h3>Formula</h3>
        <pre class="formula">{tool.formula}</pre>
        <SourcesBlock slug={tool.slug} />
        <h3>Worked example</h3>
        <p>Using the default values above, here is each step of the calculation:</p>
        <ol class="worked">{example.steps.map((s) => <li>{s}</li>)}</ol>

        <section class="assumption-box" aria-labelledby="assume-h">
          <Icon name="info" size={20} />
          <div>
            <h2 id="assume-h" class="assume-title">Assumptions</h2>
            <ul>{tool.assumptions.map((a) => <li>{a}</li>)}</ul>
            <p><strong>Data last updated:</strong> {fmtDate(data.updated)} ({data.label}).{sourcesLastChecked && <> Official sources last checked: {fmtDate(sourcesLastChecked)}.</>}
              {data.note && <span> {data.note}</span>}
            </p>
            {data.sources.length > 0 && (
              <p>Sources: {data.sources.map((s, i) => <><a href={s} rel="noopener">{new URL(s).hostname}</a>{i < data.sources.length - 1 && ', '}</>)}</p>
            )}
            <p>Estimates only, not financial advice. See the <a href="/disclaimer/">disclaimer</a>, our <a href="/methodology/">methodology</a> and <a href="/corrections/">corrections policy</a>.</p>
          </div>
        </section>

        <section class="faq-section" aria-labelledby="faq-h">
          <h2 id="faq-h">Frequently asked questions</h2>
          {tool.faq.map((f) => (
            <details class="faq"><summary>{f.q}<Icon name="chevron" size={18} /></summary><p>{f.a}</p></details>
          ))}
        </section>
      </article>

      <aside class="article-side" aria-label="Related">
        <div class="sidebar-card">
          <h2>Related calculators</h2>
          <ul>
            {related.map((t) => (
              <li><a href={`/${t.slug}/`}><span class="mini-icon"><Icon name={toolIcons[t.slug] ?? 'calc'} size={16} /></span><span>{t.shortTitle}</span><Icon name="arrow" size={14} /></a></li>
            ))}
          </ul>
        </div>
        <AdSlot placement="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
