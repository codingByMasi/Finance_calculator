---
import { SITE_NAME, CATEGORIES } from '../config/site';
import Icon from './Icon.astro';
import { dataUpdated, sourcesLastChecked, fmtDate } from '../lib/data-status';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo"><span class="logo-mark" aria-hidden="true"><Icon name="calc" size={19} /></span><span>{SITE_NAME}</span></a>
        <p>Free finance calculators for India and the US. Clear formulas, worked examples and honest assumptions.</p>
        <span>Estimates only, not financial advice.</span>
      </div>
      <nav class="footer-links" aria-label="Calculators">
        <strong>Calculators</strong>
        <a href="/in/">India</a><a href="/us/">United States</a>
        {CATEGORIES.map((c) => <a href={`/${c.slug}/`}>{c.title.replace(' calculators', '')}</a>)}
      </nav>
      <nav class="footer-links" aria-label="Company">
        <strong>Company</strong>
        <a href="/about/">About</a><a href="/guides/">Guides</a><a href="/methodology/">Methodology</a><a href="/changelog/">Data changelog</a><a href="/corrections/">Corrections</a><a href="/contact/">Contact</a>
      </nav>
      <nav class="footer-links" aria-label="Legal">
        <strong>Legal</strong>
        <a href="/privacy-policy/">Privacy Policy</a><a href="/cookie-policy/">Cookie Policy</a><a href="/terms/">Terms</a><a href="/disclaimer/">Disclaimer</a><a href="/advertising-disclosure/">Advertising disclosure</a><a href="/copyright/">Copyright and DMCA</a><a href="/accessibility/">Accessibility</a>
        <button type="button" data-open-consent>Cookie settings</button>
        <button type="button" data-open-consent>Do Not Sell or Share My Personal Information</button>
      </nav>
    </div>
    <div class="footer-bottom"><span>© {year} {SITE_NAME}</span><span>Tax data updated {fmtDate(dataUpdated.any)}{sourcesLastChecked && ` · official sources checked ${fmtDate(sourcesLastChecked)}`}</span></div>
  </div>
</footer>
