---
import { toolDataStatus, fxSnapshot } from '../lib/data-status';
interface Props { slug: string }
const s = toolDataStatus(Astro.props.slug);
const tag = { confirmed: 'Confirmed', unverified: 'Not yet confirmed', 'not-modelled': 'Not included', indicative: 'Indicative' } as const;
---
{s && (
  <section class="data-status" aria-label="Tax year and data status">
    <p class="ds-year"><strong>Applies to:</strong> {s.year}</p>
    <ul>
      {s.items.map((i) => (
        <li class={`ds ${i.status}`}><span class="tag">{tag[i.status]}</span> <strong>{i.label}.</strong> {i.note}</li>
      ))}
    </ul>
  </section>
)}
{Astro.props.slug === 'currency-converter' && (
  <p class="data-status fx-stale" data-fx-date={fxSnapshot.date} role="status" hidden>These rates are more than a week old. The automated daily update may not have run, so they may differ noticeably from current rates.</p>
  <script>import '../scripts/fx-stale';</script>
)}
